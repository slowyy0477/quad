# =============================================================================
# Quad — environment variables
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit it,
# and never paste a key into a document, an issue or a chat message.
#
# Two of these three are public by design: they are compiled into the JavaScript
# the browser downloads, and anyone can read them. That is safe *only* because
# every table has row level security, so the anon key can do nothing except what
# the policies allow. The third must never leave the server.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — required
#
# Find these in your Supabase project under Project Settings → API.
# -----------------------------------------------------------------------------

# The project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The `anon` / publishable key. Public. Sent to the browser. Row level security
# is what makes that safe, which is why every table in supabase/migrations has
# policies and why the test suite asserts them.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The `service_role` key. SECRET. Bypasses row level security completely.
#
# Never prefix this with NEXT_PUBLIC_, never import it into a Client Component,
# and never log it. It is used only by scripts/create-admin.ts and by server-side
# code that has a documented reason to bypass RLS. src/lib/supabase/admin.ts
# imports 'server-only' so that a mistake here fails the build rather than
# shipping the key to a browser.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Site — required in production
#
# The canonical origin, used to build OAuth redirect URLs and absolute links in
# metadata. No trailing slash.
#
# In development this can be left blank; it falls back to http://localhost:3000.
# In production it must be set, because the OAuth callback URL is constructed
# from it, and a wrong value sends users to someone else's site with their code.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
# Admin bootstrap — optional, used once
#
# `npm run create-admin` reads these to grant the first admin role. There is no
# hard-coded password anywhere in this repository and there must never be one:
# the script creates a user through Supabase Auth, which stores only a hash, and
# then inserts a row in public.user_roles.
#
# Set them, run the script once, then remove them from .env.local. See
# docs/ADMIN.md.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
