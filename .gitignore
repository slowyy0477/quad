# ---------------------------------------------------------------------------
# Quad — University Student Network
# See https://git-scm.com/docs/gitignore
# ---------------------------------------------------------------------------

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build
/dist
next-env.d.ts

# secrets — never commit real credentials.
# `.env.example` is the only committed env file and contains placeholders only.
.env
.env.*
!.env.example

# testing / coverage
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
.nyc_output

# supabase local tooling
supabase/.branches
supabase/.temp
supabase/.env

# editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# os
.DS_Store
Thumbs.db
desktop.ini
*.pem

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# build caches
*.tsbuildinfo
.turbo
.cache
tmp/

# scratch space for scripts and one-off probes. Never committed: it is where
# throwaway files live precisely so they do not end up in the tree by accident.
.scratch/

# deploy
.vercel

# Generated by scripts/bundle-migrations.mjs. Duplicated SQL; the migration
# files are the source of truth. Regenerate with `npm run db:bundle`.
supabase/apply-all.sql
supabase/apply-from-*.sql

# Local data store: accounts, posts, everything, in plain JSON. Never deployed.
data/
